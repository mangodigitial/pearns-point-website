# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Revalidation webhook secret (set to a random string, must match Sanity webhook config)
SANITY_REVALIDATE_SECRET=your_revalidate_secret

# ---------------------------------------------------------------------------
# Enquiry form (/api/enquiry)
# ---------------------------------------------------------------------------

# REQUIRED. Sanity project "Pearns Point" (st9j6mh7), dataset "production".
# Without this the form cannot store leads and will tell visitors to
# phone instead. Create at sanity.io/manage -> API -> Tokens, permission: Editor.
SANITY_API_WRITE_TOKEN=

# Email notification. OPTIONAL - the form works without it: the lead is still
# written to Sanity and the visitor still gets a proper thank-you. Email is the
# notification layer, not the storage layer.
#
# Sent via Brevo's transactional email API (api.brevo.com/v3/smtp/email).
# Create a v3 API key at app.brevo.com -> SMTP & API -> API Keys (NOT the SMTP
# password). The sender below must already exist as a verified sender in the
# Brevo account - "Pearns Point, Antigua" <info@pearnspoint.com> already is.
BREVO_API_KEY=

# Where enquiry notifications are sent. Comma-separate for multiple recipients.
ENQUIRY_TO_EMAIL=adam@cariblife.ag,rufus@cariblife.ag

# Must be a verified sender in the Brevo account.
ENQUIRY_FROM_EMAIL=info@pearnspoint.com
ENQUIRY_FROM_NAME=Pearns Point, Antigua
