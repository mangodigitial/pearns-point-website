# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Revalidation webhook secret (set to a random string, must match Sanity webhook config)
SANITY_REVALIDATE_SECRET=your_revalidate_secret

# ---------------------------------------------------------------------------
# Enquiry form (/api/enquiry)
# ---------------------------------------------------------------------------

# REQUIRED. Without this the form cannot store leads and will tell visitors to
# phone instead. Create at sanity.io/manage -> API -> Tokens, permission: Editor.
SANITY_API_WRITE_TOKEN=

# Email notification. OPTIONAL - the form works without it: the lead is still
# written to Sanity and the visitor still gets a proper thank-you. Email is the
# notification layer, not the storage layer.
#
# NOTE: Resend will not send FROM pearnspoint.com until the domain is verified
# (DKIM + SPF DNS records). Until that is done, either leave RESEND_API_KEY unset
# and read leads in Sanity Studio, or use the interim setup below.
RESEND_API_KEY=

# Where enquiry notifications are sent. Comma-separate for multiple recipients.
ENQUIRY_TO_EMAIL=info@orangelimited.com

# Must be on a domain verified in Resend.
# INTERIM (no DNS needed): set this to onboarding@resend.dev and point
# ENQUIRY_TO_EMAIL at your own Resend account email. Resend only delivers that
# sender to the account owner, so it is a notification path for you, not the client.
ENQUIRY_FROM_EMAIL=Pearns Point <website@pearnspoint.com>
